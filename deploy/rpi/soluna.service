[Unit]
Description=Soluna Network Audio Daemon
Documentation=https://github.com/yukihamada/opensonic
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=soluna
Group=audio
ExecStart=/usr/bin/solunad --config /etc/soluna/config.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
TimeoutStopSec=10

# Performance tuning for real-time audio
Nice=-10
LimitRTPRIO=99
LimitMEMLOCK=infinity

# CPU affinity (optional, uncomment for specific cores)
# CPUAffinity=2 3

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/log/soluna /var/lib/soluna

# Capabilities: network + real-time scheduling (SCHED_FIFO for audio thread)
AmbientCapabilities=CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_NICE
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_NICE

# Audio access
SupplementaryGroups=audio

# Environment
Environment=SOLUNA_LOG_LEVEL=info

[Install]
WantedBy=multi-user.target
