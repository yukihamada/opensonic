[Unit]
Description=Soluna Lightweight Audio Receiver (soluna-rx)
Documentation=https://github.com/yukihamada/opensonic
After=network.target sound.target

[Service]
Type=simple
User=soluna
Group=audio
# Wait for any network interface (eth0 or wlan0) to have an IP
ExecStartPre=/bin/bash -c "for i in $(seq 1 30); do \
    ip addr show eth0 2>/dev/null | grep -q 'inet ' && exit 0; \
    ip addr show wlan0 2>/dev/null | grep -q 'inet ' && exit 0; \
    sleep 1; done; exit 1"
ExecStart=/usr/local/bin/soluna-rx \
    --group ${SOLUNA_GROUP:-239.69.0.1} \
    --port ${SOLUNA_PORT:-5004} \
    --channels ${SOLUNA_CHANNELS:-2} \
    --output alsa \
    --device ${SOLUNA_DEVICE:-default}
Restart=always
RestartSec=5
TimeoutStopSec=10

# Performance tuning for real-time audio
Nice=-10
LimitRTPRIO=99
LimitMEMLOCK=infinity

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

# Capabilities: network multicast + real-time scheduling
AmbientCapabilities=CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_NICE
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_NICE

# Audio access
SupplementaryGroups=audio

# Tunable environment variables
Environment=SOLUNA_GROUP=239.69.0.1
Environment=SOLUNA_PORT=5004
Environment=SOLUNA_CHANNELS=2
Environment=SOLUNA_DEVICE=default

[Install]
WantedBy=multi-user.target
