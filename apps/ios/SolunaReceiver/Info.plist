	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>relay.solun.art</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_soluna._tcp</string>
		<string>_soluna-relay._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Soluna Rx needs access to the local network to receive audio streams from other devices.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Soluna uses the microphone to capture and transmit audio to other devices on the network.</string>
	<key>NSMotionUsageDescription</key>
	<string>Soluna uses head tracking with AirPods for spatial audio.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Soluna reads your heart rate to sync heartbeat visuals with other listeners.</string>
	<key>NSUserActivityTypes</key>
	<array>
		<string>art.solun.channel</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
