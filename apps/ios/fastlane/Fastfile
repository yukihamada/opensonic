default_platform(:ios)

platform :ios do
  # プロジェクトルートへのパス
  PROJECT_ROOT = File.expand_path("../../..", __dir__)
  APP_IDENTIFIER = "com.soluna.SolunaReceiver"
  APP_NAME = "Soluna Rx"

  desc "Build iOS library (soluna_core)"
  lane :build_lib do
    Dir.chdir(PROJECT_ROOT) do
      sh("mkdir -p build-ios")
      Dir.chdir("build-ios") do
        sh("cmake .. -G Xcode -DCMAKE_SYSTEM_NAME=iOS -DCMAKE_OSX_DEPLOYMENT_TARGET=14.0 -DCMAKE_OSX_ARCHITECTURES=arm64")
        sh("xcodebuild -project soluna.xcodeproj -scheme soluna_core -configuration Release -sdk iphoneos build")
      end
    end
  end

  desc "Create app on App Store Connect (requires Apple ID with Admin role)"
  lane :create_app do
    create_app_online(
      username: ENV["APPLE_ID"] || "mail@yukihamada.jp",
      app_identifier: APP_IDENTIFIER,
      app_name: APP_NAME,
      language: "English",
      app_version: "1.0",
      sku: APP_IDENTIFIER,
      team_id: "5BV85JW8US",
      platform: "ios"
    )
  end

  desc "Submit to TestFlight"
  lane :beta do
    # App Store Connect API Key
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath: ENV["APP_STORE_CONNECT_API_KEY_PATH"]
    )

    # Increment build number
    increment_build_number(
      build_number: Time.now.strftime("%Y%m%d%H%M")
    )

    # Build library first
    build_lib

    # Get or create provisioning profile
    sigh(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      readonly: false
    )

    # Build app
    build_app(
      project: "SolunaReceiver.xcodeproj",
      scheme: "SolunaReceiver",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "SolunaReceiver.ipa",
      clean: true
    )

    # Upload to TestFlight
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      changelog: "最新のバグ修正と機能改善"
    )
  end

  desc "Upload existing IPA to TestFlight (skip build)"
  lane :upload do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath: ENV["APP_STORE_CONNECT_API_KEY_PATH"]
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: "./build/SolunaReceiver.ipa",
      skip_waiting_for_build_processing: true,
      changelog: "最新のバグ修正と機能改善"
    )
  end

  desc "Submit to App Store review with full metadata"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath: ENV["APP_STORE_CONNECT_API_KEY_PATH"]
    )

    deliver(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false,
      overwrite_screenshots: true,
      force: true,
      submit_for_review: true,
      automatic_release: true,
      phased_release: false,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      primary_category: "MUSIC",
      secondary_category: "UTILITIES",
      copyright: "2026 Soluna",
      app_rating_config_path: "./fastlane/rating_config.json",
      submission_information: {
        add_id_info_serves_ads: false,
        add_id_info_tracks_action: false,
        add_id_info_tracks_install: false,
        add_id_info_uses_idfa: false,
        content_rights_has_rights: true,
        content_rights_contains_third_party_content: false,
        export_compliance_uses_encryption: false,
        export_compliance_is_exempt: false,
        export_compliance_contains_proprietary_cryptography: false,
        export_compliance_contains_third_party_cryptography: false
      },
      app_review_information: {
        first_name: "Yuki",
        last_name: "Hamada",
        phone_number: "+81 90 1234 5678",
        email_address: "mail@yukihamada.jp",
        demo_user: "",
        demo_password: "",
        notes: "This app receives audio over WiFi multicast. To test, run the Soluna transmitter (solunad --tx) on a Mac on the same WiFi network. The app auto-detects and plays the audio stream. No login required."
      }
    )
  end

  desc "Build for local testing (no signing)"
  lane :build_local do
    build_lib

    sh("xcodebuild -project ../SolunaReceiver.xcodeproj -scheme SolunaReceiver -configuration Release -sdk iphoneos -arch arm64 CODE_SIGN_IDENTITY='-' CODE_SIGNING_ALLOWED=NO build")
  end
end
