# ── Soluna Relay Server Environment Variables ──
# Copy this file to .env and set your values before deploying.

# Admin API key — required for /api/admin/* endpoints
# If not set, a random key is generated and printed to stderr on startup.
RELAY_ADMIN_KEY=change-me-to-a-strong-random-string

# Stripe webhook path suffix — the full endpoint becomes /api/stripe/wh-<this value>
# If not set, the webhook endpoint is disabled.
RELAY_WEBHOOK_PATH=your-stripe-webhook-secret

# Charge secret — required for UDP CHARGE commands.
# Token in CHARGE:<amount>:<token> must be prefixed with this value.
# If not set, all CHARGE commands are rejected (wallet top-up disabled via UDP).
RELAY_CHARGE_SECRET=your-charge-hmac-secret
