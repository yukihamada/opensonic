#!/bin/bash
# ──────────────────────────────────────────────────────────────
# Soluna .pkg postinstall — root 権限で実行
# ──────────────────────────────────────────────────────────────
set -uo pipefail
# NOTE: Do NOT use -e (errexit) — any non-zero exit causes "Installation failed"

SHM_DIR="/private/var/db/soluna"
SERVICE_ID="io.soluna.daemon"

# ── 1. 共有メモリディレクトリ作成 ────────────────────────────
if [ ! -d "$SHM_DIR" ]; then
    mkdir -p "$SHM_DIR"
    chmod 0755 "$SHM_DIR"
    chown root:staff "$SHM_DIR"
fi

# ── 2. coreaudiod 再起動（ドライバ認識） ─────────────────────
killall coreaudiod 2>/dev/null || true

# ── 3. コンソールユーザー検出 ────────────────────────────────
CONSOLE_USER=$(/usr/bin/stat -f "%Su" /dev/console)
if [ -z "$CONSOLE_USER" ] || [ "$CONSOLE_USER" = "root" ]; then
    exit 0
fi
CONSOLE_UID=$(id -u "$CONSOLE_USER")
CONSOLE_HOME=$(/usr/bin/dscl . -read "/Users/$CONSOLE_USER" NFSHomeDirectory | awk '{print $2}')

# ── 4. LaunchAgent インストール ──────────────────────────────
LAUNCH_AGENTS="$CONSOLE_HOME/Library/LaunchAgents"
mkdir -p "$LAUNCH_AGENTS"
chown "$CONSOLE_USER:staff" "$LAUNCH_AGENTS"

cat > "$LAUNCH_AGENTS/$SERVICE_ID.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${SERVICE_ID}</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/solunad</string>
        <string>--tx</string>
        <string>--device</string>
        <string>soluna</string>
        <string>--speaker</string>
        <string>auto</string>
        <string>--channels</string>
        <string>2</string>
        <string>--low-latency</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/solunad.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/solunad.log</string>
</dict>
</plist>
PLIST

chown "$CONSOLE_USER:staff" "$LAUNCH_AGENTS/$SERVICE_ID.plist"

# ── 5. LaunchAgent 登録 ─────────────────────────────────────
launchctl bootout "gui/$CONSOLE_UID/$SERVICE_ID" 2>/dev/null || true
sleep 1
launchctl bootstrap "gui/$CONSOLE_UID" "$LAUNCH_AGENTS/$SERVICE_ID.plist" 2>/dev/null || true

# ── 6. Soluna.app を起動 ────────────────────────────────────
if [ -d "/Applications/Soluna.app" ]; then
    su "$CONSOLE_USER" -c 'open "/Applications/Soluna.app"' 2>/dev/null &
fi

exit 0
