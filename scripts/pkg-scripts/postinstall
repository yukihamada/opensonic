#!/bin/bash
# ──────────────────────────────────────────────────────────────
# Soluna .pkg postinstall — root 権限で実行
# ──────────────────────────────────────────────────────────────
set -uo pipefail
# NOTE: Do NOT use -e (errexit) — any non-zero exit causes "Installation failed"

SHM_DIR="/private/var/db/soluna"
SERVICE_ID="io.soluna.daemon"

# ── 1. 共有メモリディレクトリ作成 ────────────────────────────
if [ ! -d "$SHM_DIR" ]; then
    mkdir -p "$SHM_DIR"
    chmod 0755 "$SHM_DIR"
    chown root:staff "$SHM_DIR"
fi

# ── 2. coreaudiod 再起動（ドライバ認識） ─────────────────────
killall coreaudiod 2>/dev/null || true

# ── 3. コンソールユーザー検出 ────────────────────────────────
CONSOLE_USER=$(/usr/bin/stat -f "%Su" /dev/console)
if [ -z "$CONSOLE_USER" ] || [ "$CONSOLE_USER" = "root" ]; then
    exit 0
fi
CONSOLE_UID=$(id -u "$CONSOLE_USER")
CONSOLE_HOME=$(/usr/bin/dscl . -read "/Users/$CONSOLE_USER" NFSHomeDirectory | awk '{print $2}')

# ── 4. solunad LaunchAgent — DISABLED ─────────────────────────
# solunad is no longer needed for normal operation.
# SDKAudioReceiver handles relay audio directly.
# If a user needs TX (system audio capture), they can start solunad manually.
LAUNCH_AGENTS="$CONSOLE_HOME/Library/LaunchAgents"
# Remove any existing solunad LaunchAgents to prevent auto-start
for PLIST_NAME in "io.soluna.daemon" "com.soluna.tx"; do
    PLIST_PATH="$LAUNCH_AGENTS/$PLIST_NAME.plist"
    if [ -f "$PLIST_PATH" ]; then
        launchctl bootout "gui/$CONSOLE_UID/$PLIST_NAME" 2>/dev/null || true
        rm -f "$PLIST_PATH"
    fi
done

# ── 6. Soluna.app を起動 ────────────────────────────────────
if [ -d "/Applications/Soluna.app" ]; then
    su "$CONSOLE_USER" -c 'open "/Applications/Soluna.app"' 2>/dev/null &
fi

exit 0
